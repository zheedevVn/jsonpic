{
  "version": 2,
  "rewrites": [
    {
      "source": "/client/admin",
      "destination": "/api/index.js?route=admin"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/admin.js"
    },
    {
      "source": "/",
      "destination": "/api/index.js?route=root"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
